# Gmail sans domaine : activer la validation en deux étapes puis créer un mot
# de passe d'application Google. Ne jamais utiliser le vrai mot de passe.
SMTP_USER=
SMTP_APP_PASSWORD=

# Le From doit utiliser la même adresse Gmail avec le transport SMTP.
FISH_EMAIL_FROM="Fish Tournament <votre-adresse@gmail.com>"

# Fallback facultatif : Resend nécessite un domaine vérifié.
RESEND_API_KEY=
